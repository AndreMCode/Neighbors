.pause-root {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.85);
}

.pause-box {
    background-color: rgb(20, 20, 20);
    border-color: rgb(200, 200, 200);
    border-width: 4px;
    border-radius: 10px;
    padding: 40px;
    width: 400px;
    align-items: stretch;
}

.header-text {
    font-size: 36px;
    color: white;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 20px;
}

.divider {
    height: 2px;
    width: 100%;
    background-color: gray;
    margin-bottom: 25px;
}

.menu-btn {
    margin-bottom: 15px;
    padding: 15px;
    font-size: 20px;
    background-color: rgb(50, 50, 50);
    color: white;
    border-color: white;
    border-width: 2px;
    border-radius: 5px;
    transition-duration: 0.1s;
}

.menu-btn:hover {
    background-color: rgb(100, 100, 100);
    scale: 1.05;
}

.menu-btn:focus {
    border-color: yellow; /* Gamepad navigation focus ring */
}

.quit-btn {
    margin-top: 15px; /* Extra separation */
    background-color: rgb(80, 20, 20);
    border-color: rgb(255, 100, 100);
}

.quit-btn:hover {
    background-color: rgb(130, 30, 30);
}