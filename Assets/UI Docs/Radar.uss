.radar-frame {
    position: absolute;
    bottom: 20px;
    left: 20px;
    width: 300px;
    height: 300px;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 15px;
    border-radius: 150px;
    border-width: 8px;
    border-color: rgba(0, 0.5, 1.0, 0.85);
}

.radar-blip {
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: #FFD700;
    border-radius: 50%;
}

.hud-victim-counter {
    font-size: 24px;
    color: #00f0ff;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    position: absolute;
    bottom: 0px;
    left: 0px;
    width: 32px;
    height: 32px;
    background-color: rgba(0, 0, 0, 0.25);
    padding: 0px;
    margin: 2px;
}