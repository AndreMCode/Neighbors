.tally-root {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.7);
}

.tally-box {
    background-color: rgb(20, 20, 20);
    border-color: rgb(200, 200, 200);
    border-width: 4px;
    border-radius: 10px;
    padding: 40px;
    width: 450px;
    align-items: center;
}

.header-text {
    font-size: 36px;
    color: rgb(0, 255, 0);
    -unity-font-style: bold;
    margin-bottom: 20px;
}

.stat-text {
    font-size: 24px;
    color: white;
    margin-top: 10px;
    margin-bottom: 10px;
}

.highlight-text {
    color: yellow;
    -unity-font-style: bold;
}

.divider {
    height: 2px;
    width: 100%;
    background-color: gray;
    margin-top: 15px;
    margin-bottom: 15px;
}

.continue-btn {
    margin-top: 30px;
    padding: 15px 30px;
    font-size: 24px;
    background-color: rgb(50, 50, 50);
    color: white;
    border-color: white;
    border-width: 2px;
    border-radius: 5px;
    transition-duration: 0.1s;
}

.continue-btn:hover {
    background-color: rgb(100, 100, 100);
    scale: 1.05;
}