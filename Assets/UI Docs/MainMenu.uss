.menu-root {
    flex-grow: 1;
    background-color: rgb(0, 0, 0);
    justify-content: center;
    align-items: center;
}

.title {
    font-size: 80px;
    -unity-font-style: bold;
    color: rgb(0, 0, 0);
    margin-bottom: 50px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(46, 139, 87);
}

.subtitle {
    font-size: 50px;
    -unity-font-style: bold;
    color: rgb(255, 128, 0);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.menu-container {
    width: 300px;
    align-items: stretch;
}

.menu-button {
    height: 60px;
    margin-bottom: 15px;
    background-color: rgba(0, 0, 0, 0.1);
    border-width: 2px;
    border-color: rgb(255, 0, 0);
    border-radius: 10px;
    color: rgb(46, 139, 87);
    font-size: 24px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
    border-left-color: rgb(25, 25, 112);
    border-right-color: rgb(25, 25, 112);
    border-top-color: rgb(25, 25, 112);
    border-bottom-color: rgb(25, 25, 112);
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgba(0, 0, 0, 0.2);
    color: rgb(154, 205, 50);
    border-color: rgb(255, 128, 0);
    scale: 1.05;
    border-left-color: rgb(46, 139, 87);
    border-right-color: rgb(46, 139, 87);
    border-top-color: rgb(46, 139, 87);
    border-bottom-color: rgb(46, 139, 87);
}

.menu-button:active {
    background-color: rgba(0, 0, 0, 0.3);
    color: rgb(255, 255, 255);
    border-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.back-button {
    margin-top: 30px;
}

.version-text {
    position: absolute;
    bottom: 20px;
    right: 20px;
    font-size: 14px;
    color: rgb(64, 64, 64);
}

.unconfigured-button {
    height: 60px;
    margin-bottom: 15px;
    background-color: rgba(32, 0, 0, 0.1);
    border-width: 2px;
    border-color: rgb(64, 64, 64);
    border-radius: 10px;
    color: rgb(64, 64, 64);
    font-size: 24px;
    -unity-font-style: bold;
}
