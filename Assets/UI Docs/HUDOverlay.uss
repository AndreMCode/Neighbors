.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    justify-content: space-between;
    pointer-events: none; /* Allows clicks to pass through to game */
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 10px 20px;
    background-color: rgba(0, 0, 0, 0.25);
    height: 40px;
}

.hud-section {
    flex-direction: row;
    align-items: center;
    height: 100%;
}

.left-section {
    width: 25%;
    justify-content: flex-start;
}

.center-section {
    width: 50%;
    justify-content: center;
}

.right-section {
    width: 25%;
    justify-content: flex-end;
}

.hud-text {
    font-size: 16px;
    color: white;
    -unity-font-style: bold;
    margin-right: 15px;
    -unity-text-align: middle-left;
}

/* Dash Cooldown Bar */
.dash-cooldown-bg {
    width: 100px;
    height: 20px;
    background-color: rgb(50, 0, 0);
    border-color: white;
    border-width: 2px;
}

.dash-cooldown-fill {
    height: 100%;
    width: 100%; /* Scaled via C# */
    background-color: rgb(0, 255, 0);
    transition-property: width, background-color;
    transition-duration: 0.2s;
}

/* Health Bar */
.health-bar-bg {
    width: 300px;
    height: 20px;
    background-color: rgb(50, 0, 0);
    border-color: white;
    border-width: 2px;
}

.health-bar-fill {
    height: 100%;
    width: 100%; /* Scaled via C# */
    background-color: rgb(0, 255, 0);
    transition-property: width, background-color;
    transition-duration: 0.2s;
}

.badge-text {
    font-size: 12px;
    color: yellow;
    -unity-font-style: bold;
    background-color: rgba(0,0,0,0.7);
    padding: 1px 3px;
}

.bottom-area {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 10px 20px;
    background-color: rgba(0, 0, 0, 0);
    height: 120px;
}

.bottom-section {
    flex-direction: row;
    align-items: center;
    height: 100%;
}

.bottom-left-section {
    width: 25%;
    justify-content: flex-start;
}

.bottom-center-section {
    width: 50%;
    justify-content: center;
    align-items: flex-end;
}

.bottom-right-section {
    width: 25%;
    justify-content: center;
}

/* Weapon & Item Icons */
.hud-icon {
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0.8);
    margin-left: 10px;
    justify-content: flex-end;
    align-items: flex-end;
}

.weapon-icon {
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0.8);
    margin-left: 10px;
    justify-content: flex-end;
    align-items: flex-end;
    align-self: flex-end;
}

.item-icon {
    width: 48px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0.8);
    margin-left: 10px;
    justify-content: flex-end;
    align-items: flex-end;
    align-self: flex-start;
}